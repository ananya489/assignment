Write-Host "================================================"
Write-Host "STEP 21: Prompt Flow implementation"
Write-Host "================================================"
Write-Host ""

Write-Host "IMPORTANT:"
Write-Host "Check deployment names and index name in:"
Write-Host ""
Write-Host "src\copilot_promptflow\flow.dag.yaml"
Write-Host ""

Read-Host "Press ENTER after checking flow.dag.yaml"

python src/run.py `
