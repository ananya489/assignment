# ------------------------------------------------------------
# STEP 26 — Deploy AI SDK copilot
# ------------------------------------------------------------

Write-Host "================================================"
Write-Host "STEP 26: Deploy copilot"
Write-Host "================================================"
Write-Host ""

Write-Host "The repository deploys the selected implementation."
Write-Host "Default implementation: aisdk"
Write-Host ""

Read-Host "Press ENTER to deploy"

python src/run.py `
    --deploy `
    --implementation aisdk

